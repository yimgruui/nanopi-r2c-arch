# SPDX-License-Identifier: GPL-3.0-or-later
# Vendored from the AUR 'udevil' package (Babahong), pinned to a commit so the
# image build is reproducible. Only the arch list and pkgver are changed.

pkgname=udevil
_commit=ce9f1c5f811e34913b050aed193a39a63ac81e73
pkgver=2026.master
pkgrel=1
pkgdesc="Automount removable media without a password (NanoPi R2C build)"
# Keep pkgver identical to the AUR package so pacman/yay do not treat this
# build as "newer" and refuse future AUR updates.
arch=('aarch64')
url="https://github.com/IgnorantGuru/udevil"
license=('GPL-3.0-or-later')
depends=('glib2')
makedepends=('intltool' 'gettext')
provides=('udevil' 'devmon')
conflicts=('udevil' 'devmon' 'devmon-git')
backup=('etc/udevil/udevil.conf' 'etc/conf.d/devmon')
options=(!strip !debug)
source=("udevil-$pkgver.tar.gz::https://codeload.github.com/IgnorantGuru/udevil/tar.gz/$_commit")
sha256sums=('92132a14477281c8e1885170b18dec49cbd6a4a18831a3f46e4e35d3001b1c5a')

build() {
    cd "udevil-$_commit"

    # GCC 15+/C23 fixes carried by the AUR package: implicit declarations are
    # hard errors now.
    sed -i '1i #include <sys/stat.h>' src/device-info.c
    sed -i -e 's/finalize(/finalize(int sig/' -e 's/interrupt(/interrupt(int sig/' src/udevil.c

    ./configure --prefix=/usr --sysconfdir=/etc
    make
}

package() {
    cd "udevil-$_commit"
    make DESTDIR="$pkgdir/" install
    # Mounting removable media as a normal user is the whole point of udevil.
    chmod +s "$pkgdir/usr/bin/udevil"
}
