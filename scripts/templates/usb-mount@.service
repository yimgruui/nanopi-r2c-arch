[Unit]
Description=Automount USB storage device /dev/%i
Documentation=file:///usr/local/sbin/usb-mount
# Skip cleanly when the kernel name does not exist (for example a Wants= from
# ksmbd when no disk is plugged in).  Do not add BindsTo= here: binding to a
# missing device unit makes systemd wait for the device timeout instead of
# skipping.  Unplugging is handled by the udev remove rule in 90-usb-mount.rules.
ConditionPathExists=/dev/%i
After=dev-%i.device

[Service]
Type=oneshot
RemainAfterExit=yes
# exFAT/vfat preen can take a while on a large volume after an unclean unplug.
TimeoutStartSec=600
ExecStart=/usr/local/sbin/usb-mount add %i
ExecStop=/usr/local/sbin/usb-mount remove %i
